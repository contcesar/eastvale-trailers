---
// Mobile-phone icon. Uses currentColor, so it takes the color of the
// surrounding text (white on the orange call buttons and the navy top bar).
const { class: className = 'h-5 w-5' } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect x="6" y="2" width="12" height="20" rx="2.5" />
  <line x1="10.5" y1="18" x2="13.5" y2="18" />
</svg>
