---
import { business } from '../data/business.js';
import PhoneIcon from './PhoneIcon.astro';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/trailers', label: 'Trailers' },
  { href: '/service-area', label: 'Service Area' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<!-- Top utility bar: phone + service line, full width -->
<div class="w-full bg-navy text-white">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-1 px-4 py-2 text-center sm:flex-row sm:text-left">
    <a
      href={business.phoneHref}
      class="inline-flex items-center gap-2 text-lg font-bold tracking-tight text-white hover:text-orange sm:text-xl"
    >
      <PhoneIcon class="h-5 w-5" /> {business.phone}
    </a>
    <p class="text-sm text-white/90">{business.tagline}</p>
  </div>
</div>

<!-- Sticky header -->
<header class="sticky top-0 z-50 w-full border-b border-border bg-surface/95 backdrop-blur">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3"
    aria-label="Main navigation"
  >
    <!-- Logo (falls back to the text wordmark if the image is missing) -->
    <a href="/" class="flex items-center gap-2" aria-label={`${business.name} home`}>
      <img
        src="/images/eastvale-trailers-logo.png?v=2"
        alt={business.name}
        width="146"
        height="48"
        class="h-12 w-auto sm:h-14"
        onerror="this.remove(); document.getElementById('logo-wordmark').classList.remove('hidden');"
      />
      <span id="logo-wordmark" class="hidden text-xl font-extrabold tracking-tight text-navy">
        Eastvale<span class="text-blue">Trailers</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-6 md:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm font-semibold text-navy transition-colors hover:text-blue"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <!-- Persistent orange Call button (visible on all breakpoints) -->
      <a
        href={business.phoneHref}
        class="inline-flex items-center gap-2 rounded-full bg-orange px-4 py-2 text-sm font-bold text-white shadow-sm transition-colors hover:bg-orange-hover"
      >
        <PhoneIcon class="h-5 w-5" />
        <span class="hidden sm:inline">Call {business.phone}</span>
        <span class="sm:hidden">Call</span>
      </a>

      <!-- Mobile hamburger -->
      <button
        id="nav-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-md p-2 text-navy hover:bg-page md:hidden"
        aria-label="Toggle menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile dropdown menu -->
  <div id="mobile-menu" class="hidden border-t border-border bg-surface md:hidden">
    <ul class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-3">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-md px-2 py-2 text-base font-semibold text-navy hover:bg-page hover:text-blue"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href={business.phoneHref}
          class="flex items-center justify-center gap-2 rounded-full bg-orange px-4 py-3 text-base font-bold text-white hover:bg-orange-hover"
        >
          <PhoneIcon class="h-5 w-5" /> Call {business.phone}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  // Vanilla JS: mobile nav toggle.
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(isOpen));
    });
    // Close the menu when a link is tapped.
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
