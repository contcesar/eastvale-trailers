---
// Simple line icons for the "Why rent from us" feature grid.
// Uses currentColor so the wrapper's text color (blue) sets the color.
const { name, class: className = 'h-8 w-8' } = Astro.props;
const common = {
  xmlns: 'http://www.w3.org/2000/svg',
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '2',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  class: className,
  'aria-hidden': 'true',
  focusable: 'false',
};
---
{
  name === 'truck' && (
    <svg {...common}>
      <path d="M3 6h11v9H3z" />
      <path d="M14 9h4l3 3v3h-7z" />
      <circle cx="7" cy="18" r="1.6" />
      <circle cx="17.5" cy="18" r="1.6" />
    </svg>
  )
}
{
  name === 'tag' && (
    <svg {...common}>
      <path d="M20.6 13.4 12 22l-9-9V4a1 1 0 0 1 1-1h8.9z" />
      <circle cx="7.5" cy="7.5" r="1.2" />
    </svg>
  )
}
{
  name === 'pin' && (
    <svg {...common}>
      <path d="M12 22s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12z" />
      <circle cx="12" cy="10" r="2.6" />
    </svg>
  )
}
{
  name === 'grid' && (
    <svg {...common}>
      <rect x="3" y="3" width="7" height="7" rx="1.5" />
      <rect x="14" y="3" width="7" height="7" rx="1.5" />
      <rect x="3" y="14" width="7" height="7" rx="1.5" />
      <rect x="14" y="14" width="7" height="7" rx="1.5" />
    </svg>
  )
}
