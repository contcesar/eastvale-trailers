---
import { business } from '../data/business.js';
import { trailers } from '../data/trailers.js';
import { cities } from '../data/cities.js';

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-border bg-surface">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Business info -->
    <div>
      <p class="text-lg font-extrabold text-navy">{business.name}</p>
      <p class="mt-3 text-sm text-muted">{business.tagline}</p>
      <a
        href={business.phoneHref}
        class="mt-3 inline-block text-base font-bold text-orange hover:text-orange-hover"
      >
        {business.phone}
      </a>
      <div class="mt-3 text-sm text-muted">
        <p class="font-semibold text-navy">Hours</p>
        {
          business.hours.map((h) => (
            <p>
              {h.days}: {h.time}
            </p>
          ))
        }
      </div>
    </div>

    <!-- Trailer types -->
    <div>
      <p class="text-sm font-bold uppercase tracking-wide text-navy">Trailer Types</p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          trailers.map((t) => (
            <li>
              <a href={`/trailers/${t.slug}`} class="text-muted hover:text-blue">
                {t.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Service area -->
    <div>
      <p class="text-sm font-bold uppercase tracking-wide text-navy">Service Area</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a href="/service-area" class="font-semibold text-muted hover:text-blue">
            {business.homeCity} (home base)
          </a>
        </li>
        {
          cities.map((c) => (
            <li>
              <a href={`/service-area/${c.slug}`} class="text-muted hover:text-blue">
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Quick links -->
    <div>
      <p class="text-sm font-bold uppercase tracking-wide text-navy">Quick Links</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/" class="text-muted hover:text-blue">Home</a></li>
        <li><a href="/trailers" class="text-muted hover:text-blue">All Trailers</a></li>
        <li><a href="/service-area" class="text-muted hover:text-blue">Service Area</a></li>
        <li><a href="/about" class="text-muted hover:text-blue">About</a></li>
        <li><a href="/contact" class="text-muted hover:text-blue">Contact & Quote</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-5 text-center text-sm text-muted">
      &copy; {year} {business.name}. All rights reserved.
    </div>
  </div>
</footer>
