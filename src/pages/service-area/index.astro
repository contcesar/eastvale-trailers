---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CityCard from '../../components/CityCard.astro';
import CTASection from '../../components/CTASection.astro';
import { business } from '../../data/business.js';
import { cities } from '../../data/cities.js';

const title = 'Service Area';
const description = `We rent trailers in ${business.homeCity} and nearby cities: Corona, Norco, Jurupa Valley, Chino, Chino Hills, Ontario, and Riverside. Pickup from our Eastvale lot.`;
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-4xl font-extrabold text-navy">Our Service Area</h1>
    <div class="mt-6 rounded-[16px] border border-border bg-surface p-6 shadow-[var(--shadow-card)]">
      <h2 class="text-2xl font-bold text-blue">{business.homeCity} is our home base</h2>
      <p class="mt-2 max-w-3xl text-muted">
        {business.name} is based in {business.homeCity}, California. That’s where you pick
        up your trailer, and it keeps us close to the cities around us. Don’t see your
        city? Call us. We may still be able to help.
      </p>
    </div>

    <h2 class="mt-12 text-2xl font-extrabold text-navy">Cities we serve</h2>
    <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {cities.map((city) => <CityCard city={city} />)}
    </div>
  </section>

  <div class="pb-16">
    <CTASection heading="Trailers for your area" text="Call or request a quote and we’ll line up the right trailer." />
  </div>
</BaseLayout>
