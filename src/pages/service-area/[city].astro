---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import TrailerCard from '../../components/TrailerCard.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { cities } from '../../data/cities.js';
import { trailers } from '../../data/trailers.js';
import { business } from '../../data/business.js';

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const title = `Trailer Rentals in ${city.name}, CA`;
const description = `Rent enclosed, flatbed, tilt, car, utility, and gooseneck trailers in ${city.name}, CA. ${business.name} delivers dependable trailers to the ${city.name} area.`;
---

<BaseLayout title={title} description={description} schemaCity={city.name}>
  <article class="mx-auto max-w-6xl px-4 py-12">
    <nav class="text-sm text-muted" aria-label="Breadcrumb">
      <a href="/service-area" class="hover:text-blue">Service Area</a>
      <span aria-hidden="true"> / </span>
      <span class="text-navy">{city.name}</span>
    </nav>

    <h1 class="mt-4 text-4xl font-extrabold text-navy">
      Trailer Rentals in {city.name}, CA
    </h1>
    <p class="mt-4 max-w-3xl text-lg text-muted">{city.intro}</p>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <Button href={business.phoneHref} variant="primary">
        <span aria-hidden="true">📞</span> Call {business.phone}
      </Button>
      <Button href="/contact" variant="secondary">Request a Quote</Button>
    </div>

    <!-- All six trailer types -->
    <h2 class="mt-14 text-2xl font-extrabold text-navy">
      Trailers available in {city.name}
    </h2>
    <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {trailers.map((trailer) => <TrailerCard trailer={trailer} />)}
    </div>

    <!-- Delivery / pickup note -->
    <div class="mt-12 rounded-[14px] border border-border bg-surface p-6 shadow-[var(--shadow-card)]">
      <h2 class="text-xl font-bold text-navy">Delivery & pickup for {city.name}</h2>
      <p class="mt-2 text-muted">
        {city.name} is a short tow from our {business.homeCity} base, so pickup is quick and
        convenient. Ask about delivery options for larger jobs when you call or request a quote.
      </p>
    </div>

    <!-- Map embed placeholder -->
    <div class="mt-8">
      <h2 class="text-xl font-bold text-navy">Find us</h2>
      <!-- TODO: Replace this placeholder with a real Google Maps embed for the service area. -->
      <div
        class="mt-3 flex aspect-[16/9] items-center justify-center rounded-[14px] border border-dashed border-border bg-page text-muted"
      >
        <span class="px-6 text-center text-sm">Map embed coming soon (TODO)</span>
      </div>
    </div>

    <!-- Quote form -->
    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-extrabold text-navy">Request a Quote in {city.name}</h2>
        <p class="mt-2 text-muted">
          Tell us what you need to haul and your dates. We’ll get right back to you.
        </p>
      </div>
      <QuoteForm />
    </div>
  </article>
</BaseLayout>
