---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import { trailers } from '../../data/trailers.js';
import { business } from '../../data/business.js';

export function getStaticPaths() {
  return trailers.map((trailer) => ({
    params: { type: trailer.slug },
    props: { trailer },
  }));
}

const { trailer } = Astro.props;
const title = `${trailer.name} for Rent in Eastvale, CA`;
const description = `${trailer.blurb} Rent a ${trailer.name.toLowerCase().replace(/s$/, '')} from Eastvale Trailers, serving ${business.homeCity} and nearby cities.`;
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-6xl px-4 py-12">
    <nav class="text-sm text-muted" aria-label="Breadcrumb">
      <a href="/trailers" class="hover:text-blue">Trailers</a>
      <span aria-hidden="true"> / </span>
      <span class="text-navy">{trailer.name}</span>
    </nav>

    <div class="mt-4 grid gap-10 lg:grid-cols-2">
      <div>
        <h1 class="text-4xl font-extrabold text-navy">{trailer.name}</h1>
        <p class="mt-4 text-lg text-muted">{trailer.description}</p>

        <h2 class="mt-8 text-xl font-bold text-navy">Common uses</h2>
        <ul class="mt-3 space-y-2">
          {
            trailer.uses.map((use) => (
              <li class="flex items-start gap-2 text-muted">
                <span class="mt-1 text-blue" aria-hidden="true">&#10003;</span>
                <span>{use}</span>
              </li>
            ))
          }
        </ul>

        <!-- Rates placeholder table. TODO: fill in real rates. -->
        <h2 class="mt-8 text-xl font-bold text-navy">Rates</h2>
        <div class="mt-3 overflow-hidden rounded-[14px] border border-border">
          <table class="w-full text-left text-sm">
            <thead class="bg-page text-navy">
              <tr>
                <th class="px-4 py-3 font-semibold">Rental period</th>
                <th class="px-4 py-3 font-semibold">Rate</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border text-muted">
              <tr>
                <td class="px-4 py-3">Half day</td>
                <td class="px-4 py-3">$XX <span class="text-xs">(TODO)</span></td>
              </tr>
              <tr>
                <td class="px-4 py-3">Full day</td>
                <td class="px-4 py-3">{trailer.starterRate} <span class="text-xs">(TODO)</span></td>
              </tr>
              <tr>
                <td class="px-4 py-3">Weekend</td>
                <td class="px-4 py-3">$XX <span class="text-xs">(TODO)</span></td>
              </tr>
              <tr>
                <td class="px-4 py-3">Weekly</td>
                <td class="px-4 py-3">$XX <span class="text-xs">(TODO)</span></td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="mt-6 text-muted">
          Available for pickup across
          <a href="/service-area" class="font-semibold text-blue hover:text-blue-hover">
            Eastvale and nearby cities</a>.
        </p>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <Button href={business.phoneHref} variant="primary">
            <span aria-hidden="true">📞</span> Call {business.phone}
          </Button>
          <Button href="/contact" variant="secondary">Contact Us</Button>
        </div>
      </div>

      <div>
        <!-- Large image slot. TODO: add a real photo for this trailer. -->
        <div
          class="flex aspect-[4/3] items-center justify-center rounded-[16px] border border-border bg-surface text-muted shadow-[var(--shadow-card)]"
        >
          <span class="px-6 text-center text-sm">Photo of {trailer.name.toLowerCase()} coming soon</span>
        </div>

        <div class="mt-8">
          <h2 class="text-2xl font-extrabold text-navy">Request a Quote</h2>
          <p class="mt-2 text-muted">Tell us your dates and we’ll get right back to you.</p>
          <div class="mt-4">
            <QuoteForm selectedTrailer={trailer.slug} />
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
