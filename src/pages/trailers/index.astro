---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrailerCard from '../../components/TrailerCard.astro';
import CTASection from '../../components/CTASection.astro';
import { trailers } from '../../data/trailers.js';

const title = 'Trailer Rentals';
const description =
  'See every trailer we rent in Eastvale: enclosed, flatbed, tilt, car, utility, and gooseneck. Sizes, day and week rates, and a quick quote form.';
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="text-center">
      <h1 class="text-4xl font-extrabold text-navy">Trailers we rent</h1>
      <p class="mx-auto mt-3 max-w-2xl text-muted">
        Six types to cover most hauling jobs. Pick one for sizes, uses, and rates.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {trailers.map((trailer, i) => <TrailerCard trailer={trailer} loading={i < 3 ? 'eager' : 'lazy'} />)}
    </div>
  </section>

  <div class="pb-16">
    <CTASection heading="Not sure which trailer you need?" text="Call us and we’ll help you pick the right one for the job." />
  </div>
</BaseLayout>
