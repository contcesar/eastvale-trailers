---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { business } from '../data/business.js';

const title = 'Contact & Quote Request';
const description = `Call ${business.name} at ${business.phone} or request a trailer rental quote online. Based in ${business.homeCity}, CA, serving nearby cities.`;
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-4xl font-extrabold text-navy">Contact & Quote Request</h1>
    <p class="mt-3 max-w-2xl text-muted">
      Call us or send the form. We’ll get back to you with what’s available and what it costs.
    </p>

    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <!-- Contact details -->
      <div>
        <div class="rounded-[14px] border border-border bg-surface p-6 shadow-[var(--shadow-card)]">
          <h2 class="text-xl font-bold text-navy">Call us</h2>
          <a
            href={business.phoneHref}
            class="mt-1 inline-block text-2xl font-extrabold text-orange hover:text-orange-hover"
          >
            {business.phone}
          </a>

          <h2 class="mt-6 text-xl font-bold text-navy">Hours</h2>
          <ul class="mt-1 text-muted">
            {business.hours.map((h) => <li>{h.days}: {h.time}</li>)}
          </ul>
        </div>

        <!-- Map embed placeholder -->
        <div class="mt-6">
          <h2 class="text-xl font-bold text-navy">Find us</h2>
          <!-- TODO: Replace this placeholder with a real Google Maps embed. -->
          <div
            class="mt-3 flex aspect-[16/9] items-center justify-center rounded-[14px] border border-dashed border-border bg-page text-muted"
          >
            <span class="px-6 text-center text-sm">Map embed coming soon (TODO)</span>
          </div>
        </div>
      </div>

      <!-- Quote form -->
      <div>
        <h2 class="text-2xl font-extrabold text-navy">Request a Quote</h2>
        <p class="mt-2 text-muted">Fill in the details and we’ll get back to you fast.</p>
        <div class="mt-4">
          <QuoteForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
