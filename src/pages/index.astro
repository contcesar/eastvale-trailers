---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PhoneIcon from '../components/PhoneIcon.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import TrailerCard from '../components/TrailerCard.astro';
import CTASection from '../components/CTASection.astro';
import { business } from '../data/business.js';
import { trailers } from '../data/trailers.js';
import { cities } from '../data/cities.js';

const title = 'Trailer Rentals in Eastvale, CA';
const description =
  'Rent enclosed, flatbed, tilt, car, utility, and gooseneck trailers in Eastvale, CA. Day and week rates, with pickup for Corona, Norco, Chino, and nearby cities.';

const features = [
  {
    icon: 'truck',
    title: 'Delivery & pickup',
    // TODO: Confirm whether you deliver and what the fees are.
    text: 'We can deliver and pick up at your home or job site. Ask about fees when you call.',
  },
  {
    icon: 'tag',
    title: 'Clear rates',
    text: 'Day and week prices are listed on every trailer page. No surprises.',
  },
  {
    icon: 'pin',
    title: 'Local pickup',
    text: `Pick up in ${business.homeCity}, close to Corona, Norco, Chino, and more.`,
  },
  {
    icon: 'grid',
    title: 'Six trailer types',
    text: 'From utility trailers to goosenecks. Pick the size your load needs.',
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- 1. Hero -->
  <section class="bg-page">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-2 lg:py-24">
      <div>
        <h1 class="text-4xl font-extrabold leading-tight text-navy sm:text-5xl">
          Trailer Rentals in <span class="text-blue">Eastvale, CA</span>
        </h1>
        <p class="mt-4 max-w-xl text-lg text-muted">
          Rent the trailer you need for the day, the weekend, or the week. We’re in
          Eastvale and serve Corona, Norco, Jurupa Valley, Chino, Chino Hills, Ontario,
          and Riverside.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={business.phoneHref} variant="primary">
            <PhoneIcon class="h-5 w-5" /> Call {business.phone}
          </Button>
          <Button href="/contact" variant="secondary">Request a Quote</Button>
        </div>
      </div>

      <!-- Hero image -->
      <div class="aspect-[4/3] overflow-hidden rounded-[16px] border border-border bg-surface shadow-[var(--shadow-card)]">
        <img
          src="/images/hero.webp"
          alt="Trailer rentals from Eastvale Trailers"
          width="1479"
          height="1063"
          loading="eager"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- 2. Trailer types grid -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold text-navy">
        Pick the trailer for your job
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-muted">
        Six types to cover most hauls. Tap one for sizes, uses, and rates.
      </p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {trailers.map((trailer) => <TrailerCard trailer={trailer} />)}
    </div>
  </section>

  <!-- 3. Why rent from us -->
  <section class="bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-3xl font-extrabold text-navy sm:text-4xl">Why Rent From Us?</h2>
      <p class="mt-4 max-w-3xl text-muted">
        Renting a trailer should be quick and clear. Reserve the size you need, pick it up
        in {business.homeCity}, and get to work. Here’s what you get when you rent with us.
      </p>
      <div class="mt-12 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          features.map((f) => (
            <div class="text-center">
              <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-blue/10 text-blue">
                <FeatureIcon name={f.icon} class="h-7 w-7" />
              </div>
              <h3 class="mt-4 text-lg font-bold text-navy">{f.title}</h3>
              <p class="mx-auto mt-2 max-w-xs text-sm text-muted">{f.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Service area -->
  <section class="mx-auto max-w-6xl px-4 py-16 text-center">
    <h2 class="text-3xl font-extrabold text-navy">Where we rent</h2>
    <p class="mx-auto mt-3 max-w-2xl text-muted">
      We’re based in {business.homeCity}. Pick your city:
    </p>
    <ul class="mt-6 flex flex-wrap justify-center gap-3">
      {
        cities.map((c) => (
          <li>
            <a
              href={`/service-area/${c.slug}`}
              class="inline-block rounded-full border border-border bg-surface px-4 py-2 text-sm font-semibold text-blue transition-colors hover:border-blue hover:bg-blue hover:text-white"
            >
              {c.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 5. Quote strip -->
  <div class="pb-16">
    <CTASection />
  </div>
</BaseLayout>
