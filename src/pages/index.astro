---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import TrailerCard from '../components/TrailerCard.astro';
import CTASection from '../components/CTASection.astro';
import { business } from '../data/business.js';
import { trailers } from '../data/trailers.js';
import { cities } from '../data/cities.js';

const title = 'Trailer Rentals in Eastvale, CA';
const description =
  'Trailer rentals in Eastvale, CA. Enclosed, flatbed, tilt, car, utility, and gooseneck trailers for pickup across Eastvale and nearby cities. Call for a fast quote.';

const trustPoints = [
  {
    title: 'Well-maintained trailers',
    text: 'Every trailer is inspected and road-ready, so you tow with confidence.',
  },
  {
    title: 'Local pickup',
    text: `Convenient pickup from our ${business.homeCity} base, close to the cities we serve.`,
  },
  {
    title: 'Fair, clear rates',
    text: 'Straightforward pricing with no surprises. Ask about daily and multi-day rates.',
  },
  {
    title: 'Quick reservations',
    text: 'Call or request a quote and we’ll get you booked fast.',
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- 1. Hero -->
  <section class="bg-page">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-2 lg:py-24">
      <div>
        <h1 class="text-4xl font-extrabold leading-tight text-navy sm:text-5xl">
          Trailer Rentals in <span class="text-blue">Eastvale, CA</span>
        </h1>
        <p class="mt-4 max-w-xl text-lg text-muted">
          Enclosed, flatbed, tilt, car, utility, and gooseneck trailers for rent,
          serving {business.homeCity} and nearby cities including Corona, Norco,
          Jurupa Valley, Chino, Chino Hills, Ontario, and Riverside.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={business.phoneHref} variant="primary">
            <span aria-hidden="true">📞</span> Call {business.phone}
          </Button>
          <Button href="/contact" variant="secondary">Request a Quote</Button>
        </div>
      </div>

      <!-- Hero image slot. TODO: add a real hero photo. -->
      <div
        class="flex aspect-[4/3] items-center justify-center rounded-[16px] border border-border bg-surface text-muted shadow-[var(--shadow-card)]"
      >
        <!-- TODO: Replace with a hero photo, e.g. /public/images/hero.jpg -->
        <span class="px-6 text-center text-sm">Hero photo coming soon</span>
      </div>
    </div>
  </section>

  <!-- 2. Trailer types grid -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold text-navy">
        Choose From Our Selection of Trailer Rentals
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-muted">
        Find the right trailer for the job. Tap any type to see details and request a quote.
      </p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {trailers.map((trailer) => <TrailerCard trailer={trailer} />)}
    </div>
  </section>

  <!-- 3. Why rent from us -->
  <section class="bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-center text-3xl font-extrabold text-navy">Why Rent From Us</h2>
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          trustPoints.map((point) => (
            <div class="rounded-[14px] border border-border bg-page p-6">
              <h3 class="text-lg font-bold text-blue">{point.title}</h3>
              <p class="mt-2 text-sm text-muted">{point.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Service area -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-3xl font-extrabold text-navy">Serving Eastvale & Nearby Cities</h2>
    <p class="mt-3 max-w-2xl text-muted">
      Based in {business.homeCity}, we deliver dependable trailer rentals across the region.
      Pick your city to learn more:
    </p>
    <ul class="mt-6 flex flex-wrap gap-3">
      {
        cities.map((c) => (
          <li>
            <a
              href={`/service-area/${c.slug}`}
              class="inline-block rounded-full border border-border bg-surface px-4 py-2 text-sm font-semibold text-blue transition-colors hover:border-blue hover:bg-blue hover:text-white"
            >
              {c.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 5. Quote strip -->
  <div class="pb-16">
    <CTASection />
  </div>
</BaseLayout>
