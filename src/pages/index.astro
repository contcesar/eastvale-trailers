---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PhoneIcon from '../components/PhoneIcon.astro';
import TrailerCard from '../components/TrailerCard.astro';
import CTASection from '../components/CTASection.astro';
import { business } from '../data/business.js';
import { trailers } from '../data/trailers.js';
import { cities } from '../data/cities.js';

const title = 'Trailer Rentals in Eastvale, CA';
const description =
  'Rent enclosed, flatbed, tilt, car, utility, and gooseneck trailers in Eastvale, CA. Day and week rates, with pickup for Corona, Norco, Chino, and nearby cities.';

const trustPoints = [
  {
    title: 'Trailers for any job',
    text: 'Six types, from utility trailers to goosenecks. Pick the size your load needs.',
  },
  {
    title: 'Local pickup',
    text: `Pick up in ${business.homeCity}, close to the cities we serve.`,
  },
  {
    title: 'Clear rates',
    text: 'See day and week prices up front. Ask about multi-day rates.',
  },
  {
    title: 'Quick booking',
    text: 'Call or send a quote request and we’ll get you booked.',
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- 1. Hero -->
  <section class="bg-page">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-2 lg:py-24">
      <div>
        <h1 class="text-4xl font-extrabold leading-tight text-navy sm:text-5xl">
          Trailer Rentals in <span class="text-blue">Eastvale, CA</span>
        </h1>
        <p class="mt-4 max-w-xl text-lg text-muted">
          Rent the trailer you need for the day, the weekend, or the week. We’re in
          {business.homeCity} and serve Corona, Norco, Jurupa Valley, Chino, Chino Hills,
          Ontario, and Riverside.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={business.phoneHref} variant="primary">
            <PhoneIcon class="h-5 w-5" /> Call {business.phone}
          </Button>
          <Button href="/contact" variant="secondary">Request a Quote</Button>
        </div>
      </div>

      <!-- Hero image -->
      <div class="aspect-[4/3] overflow-hidden rounded-[16px] border border-border bg-surface shadow-[var(--shadow-card)]">
        <img
          src="/images/hero.png"
          alt="Trailer rentals from Eastvale Trailers"
          width="1479"
          height="1063"
          loading="eager"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- 2. Trailer types grid -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold text-navy">
        Pick the trailer for your job
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-muted">
        Six types to cover most hauls. Tap one for sizes, uses, and rates.
      </p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {trailers.map((trailer) => <TrailerCard trailer={trailer} />)}
    </div>
  </section>

  <!-- 3. Why rent from us -->
  <section class="bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-center text-3xl font-extrabold text-navy">Why rent from us</h2>
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          trustPoints.map((point) => (
            <div class="rounded-[14px] border border-border bg-page p-6">
              <h3 class="text-lg font-bold text-blue">{point.title}</h3>
              <p class="mt-2 text-sm text-muted">{point.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Service area -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-3xl font-extrabold text-navy">Where we rent</h2>
    <p class="mt-3 max-w-2xl text-muted">
      We’re based in {business.homeCity}. Pick your city:
    </p>
    <ul class="mt-6 flex flex-wrap gap-3">
      {
        cities.map((c) => (
          <li>
            <a
              href={`/service-area/${c.slug}`}
              class="inline-block rounded-full border border-border bg-surface px-4 py-2 text-sm font-semibold text-blue transition-colors hover:border-blue hover:bg-blue hover:text-white"
            >
              {c.name}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 5. Quote strip -->
  <div class="pb-16">
    <CTASection />
  </div>
</BaseLayout>
