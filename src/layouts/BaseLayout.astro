---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../data/business.js';

const {
  title,
  description,
  // Optional: pass a city name to emit a city-specific LocalBusiness schema.
  schemaCity = null,
} = Astro.props;

const siteName = business.name;
const fullTitle = title ? `${title} | ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site ?? business.url).href;

// LocalBusiness JSON-LD. On city pages, name the city in the area served.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: siteName,
  telephone: business.phone,
  url: business.url,
  address: {
    '@type': 'PostalAddress',
    addressLocality: business.homeCity,
    addressRegion: business.region,
    addressCountry: 'US',
  },
  areaServed: schemaCity
    ? { '@type': 'City', name: `${schemaCity}, CA` }
    : `${business.homeCity} and nearby cities in ${business.region}`,
  priceRange: '$$',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Favicon (TODO: replace with a real branded favicon). -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- TODO: add a real share image at /public/images/og.jpg -->
    <meta property="og:image" content={new URL('/images/og.jpg', Astro.site ?? business.url).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts: Inter, with preconnect for faster loading. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- LocalBusiness structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
